 "source": "baseballcardpedia-2026-09-13",
 "acquiredAt": "2026-09-13",
 "duplicateIdentityRowsDropped": 566,
 "duplicateIdentityNote": "BCP relists a card under Gimmicks/Errors-and-Variations with the same number and the same player text to note an UNNAMED variation; those rows carry the identity of the base row, so they were dropped (one card, one row, one pool). A variation the page NAMES differs in its player text and is kept as the distinct card it is.",
 "variationAxisApplied": {
  "appliedAt": "2026-09-13",
  "source": "baseballcardpedia-2026-09-13",
  "why": "#2112's insert-set-key guard refused this file: rows would have landed on fewer distinct ids than there are rows, so a later row would have overwritten an earlier one inside one run and the last writer would have decided which card the address holds. Every decision below was verified against the live baseballcardpedia page before it was applied; nothing here invents a label the source does not print.",
  "decisions": {
   "imageVariations": {
    "rows": 648,
    "rule": "image variation — the photo descriptor bcp prints after the player's name moves to the parallel axis as \"<Name> Image Variation SP\" (#1613), and the photo names the subset so the base ladder is not multiplied by it"
   },
   "trailingPrintRunMoved": {
    "rows": 170,
    "rule": "trailing serial — bcp writes a rung's print run inside the player cell (\"Adrian Beltre 25\"); it is moved to printRun, which is what lets a rung's roster compare equal to its root's"
   },
   "namedSubsetRestored": {
    "rows": 12,
    "rule": "named subset — the source prints a heading for these rows that the scrape flattened into `base`; the category is restored to the section the source names"
   },
   "duplicatesDropped": {
    "rows": 12,
    "rule": "duplicate — a byte-identical row, or a repeat of a checklist line under a misspelling of the same player with no descriptor to make it a distinct card"
   }
  },
  "rowsBefore": 14879,
  "rowsAfter": 10203,
  "distinctIdsAfter": 10191,
  "verdictAfter": "refuse",
  "heldRows": {
   "rows": 64,
   "groups": 32,
   "rule": "held — the source prints this number more than once and prints nothing that distinguishes the printings; both sides are withheld (absent beats wrong)",

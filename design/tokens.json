{
  "$comment": "HobbyIQ design tokens — single source of truth for iOS + web. Edit here; run `npm run gen:design-tokens` (or `node design/gen-tokens.mjs`) to regenerate HobbyIQ/DesignSystem/HobbyIQTokens.generated.swift + apps/web/src/app/tokens.generated.css. Never edit those generated files by hand.",
  "colors": {
    "deepNavy":       "#0B1424",
    "appBackground":  "#06101D",
    "cardNavy":       "#101B2D",
    "slateGray":      "#1A2333",
    "steelGray":      "#2A3344",
    "electricBlue":   "#1E90FF",
    "brightBlue":     "#3DA9FF",
    "hobbyGreen":     "#7CFF72",
    "brightGreen":    "#B6FF4D",
    "successGreen":   "#41E66F",
    "mutedText":      "#C4CDD9",
    "pureWhite":      "#FFFFFF",
    "warning":        "#FFA500",
    "danger":         "#FF3B30"
  },
  "alphaTokens": {
    "$comment": "Derived — same base color with a specific alpha. Kept explicit so both platforms produce the same rgba().",
    "subtleSurface":  { "base": "pureWhite",   "alpha": 0.05 },
    "border":         { "base": "steelGray",   "alpha": 0.88 },
    "softBorder":     { "base": "electricBlue","alpha": 0.28 },
    "glow":           { "base": "electricBlue","alpha": 0.24 },
    "successGlow":    { "base": "hobbyGreen",  "alpha": 0.24 },
    "shadow":         { "base": "#000000",     "alpha": 0.35 }
  },
  "gradients": {
    "brand": {
      "$comment": "The muted blue→green diagonal used on primary tile edges, search bar, and modal.",
      "angleDeg": 135,
      "stops": [
        { "color": "#2A6A9E", "position": 0.0 },
        { "color": "#2C8F66", "position": 1.0 }
      ]
    }
  },
  "spacing": {
    "xxSmall":       4,
    "xSmall":        8,
    "small":         12,
    "medium":        16,
    "large":         20,
    "xLarge":        24,
    "xxLarge":       32,
    "screenPadding": 16,
    "cardPadding":   18
  },
  "radius": {
    "xSmall": 10,
    "small":  14,
    "medium": 18,
    "large":  24,
    "xLarge": 28,
    "pill":   999
  },
  "typography": {
    "$comment": "size in px. weight is CSS-numeric (400=regular, 600=semibold, 700=bold). design is SF Pro's design axis on iOS — 'rounded' or 'default'. line-height is a unitless multiplier.",
    "hero":              { "size": 34, "weight": 700, "design": "rounded", "lineHeight": 1.15 },
    "title":             { "size": 28, "weight": 700, "design": "rounded", "lineHeight": 1.2  },
    "sectionTitle":      { "size": 22, "weight": 700, "design": "rounded", "lineHeight": 1.25 },
    "cardTitle":         { "size": 18, "weight": 600, "design": "rounded", "lineHeight": 1.3  },
    "body":              { "size": 16, "weight": 400, "design": "default", "lineHeight": 1.4  },
    "bodyEmphasis":      { "size": 16, "weight": 600, "design": "default", "lineHeight": 1.4  },
    "caption":           { "size": 13, "weight": 400, "design": "default", "lineHeight": 1.35 },
    "captionEmphasis":   { "size": 13, "weight": 600, "design": "default", "lineHeight": 1.35 },
    "statNumber":        { "size": 30, "weight": 700, "design": "rounded", "lineHeight": 1.1  },
    "statSubtle":        { "size": 15, "weight": 600, "design": "rounded", "lineHeight": 1.3  }
  }
}
